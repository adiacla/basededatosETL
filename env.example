# Copia este archivo como .env (Copy-Item .env.example .env) y ajusta los valores.
# No subas .env a Git. No uses el caracter $ en las claves.

# Los notebooks de python/ usan la clave "root". Si la cambias, cambiala tambien en los notebooks.
MYSQL_ROOT_PASSWORD=root

# Credenciales de la web de Airflow (http://localhost:8080)
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_ADMIN_FIRSTNAME=Tu
AIRFLOW_ADMIN_LASTNAME=Nombre
AIRFLOW_ADMIN_EMAIL=tu_correo@dominio.com
